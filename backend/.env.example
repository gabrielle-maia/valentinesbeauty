NODE_ENV=development
PORT=3333

# Segredo usado para assinar os tokens (mínimo 16 caracteres). Troque em produção.
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_SECONDS=604800

DATABASE_PATH=./data/valentines.db
UPLOADS_DIR=./uploads

# Origens permitidas (separe por vírgula) ou * para liberar todas
CORS_ORIGIN=*

# Super Admin criado na primeira execução (mesmas credenciais de demonstração do front)
ADMIN_NAME=Super Administrador
ADMIN_EMAIL=admin@valenbeauty.com
ADMIN_PASSWORD=123456
